# ===========================================================================
# 本地验证模板（local.sh init 使用，local profile：Caddy）
#
# DATA_ROOT 占位由脚本替换为仓库下的 .local-data；
# 使用 *.localhost 域名与 18080/18443 非特权端口，适合 macOS / Docker Desktop。
# 生成目标为 .local-data/.env，不入 Git。
#
# 本地与生产同构：公网/本地只暴露 2 个控制台入口（mcs / easybot 后台）；
# EasyBot 插件 API 仅内网（插件直连 http://easybot:8080），无独立域名。
# ===========================================================================

# 基础环境
TZ=Asia/Shanghai
DATA_ROOT=<DATA_ROOT>
# 本地 *.localhost 使用 Caddy 本地 CA，不触发 ACME，此值仅为占位
CADDY_EMAIL=local@localhost.invalid

# 本地使用非特权端口，避免占用 80/443
PROXY_HTTP_PORT=18080
PROXY_HTTPS_PORT=18443

# 使用 localhost 域名便于 Caddy 在本地生成证书并做反向代理
DOMAIN_MCS_WEB=mcs.localhost
DOMAIN_EASY_ADMIN=easybot.localhost
DOMAIN_MCS_NODE=mcs-node.localhost

# EasyBot
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=local_strong_password_change_me

# MCSManager 端口
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444

# QQ 开放平台凭据（本地验证无真实账号可先保留占位）
QQBOT_APP_ID=local_app_id
QQBOT_CLIENT_SECRET=local_client_secret
QQBOT_GUILD_ID=4678868088901888449
QQBOT_CHANNEL_ID=716172984
QQBOT_DM_GUILD_ID=4678868088901888449
QQBOT_PRIVATE_USER_ID=1F57730D6ADC5F5CD417D5614A52F2CF
QQBOT_MEMBER_LIMIT=20
QQBOT_TEST_MESSAGE=hello from local qq bot
