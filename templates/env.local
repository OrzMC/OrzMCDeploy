# ===========================================================================
# 本地验证模板（local.sh init 使用，local profile：Caddy）
#
# DATA_ROOT 占位由脚本替换为仓库下的 .local-data；
# 使用 *.localhost 域名与 18080/18443 非特权端口，适合 macOS / Docker Desktop。
# 生成目标为 .local-data/.env，不入 Git。
#
# 本地与生产同构：暴露 4 个入口（mcs / easybot / mcs-node 后台 + orzmcs 状态页），
# EasyBot 插件 API 仅内网（插件直连 http://easybot:8080），无独立域名。
# ===========================================================================

# ==================== 基础 ====================
TZ=Asia/Shanghai
DATA_ROOT=<DATA_ROOT>

# ==================== 边缘层：Caddy ====================
# 本地 *.localhost 使用 Caddy 本地 CA，不触发 ACME，此值仅为占位
CADDY_EMAIL=local@localhost.invalid
# 本地使用非特权端口，避免占用 80/443
PROXY_HTTP_PORT=18080
PROXY_HTTPS_PORT=18443

# ==================== 公网入口域名 ====================
# 使用 localhost 域名便于 Caddy 在本地生成证书并做反向代理；
# orzmcs 为统一状态页（Gatus，第 4 个本地入口）
DOMAIN_MCS_WEB=mcs.localhost
DOMAIN_EASY_ADMIN=easybot.localhost
DOMAIN_MCS_NODE=mcs-node.localhost
DOMAIN_STATUS=orzmcs.localhost

# ==================== EasyBot 网关 ====================
# 监听器仅 HTTP，TLS 由 Caddy 承担；微信适配器默认自动启用，禁用见
# docs/easybot.md（gateway.local.yaml）
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=local_strong_password_change_me

# ==================== MCSManager 平台 ====================
# 容器内端口，仅 expose 不发布宿主机
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444

# ==================== daemon 内存上限（issue #10） ====================
# daemon 容器内存上限与 Node 堆上限：均由这两个变量派生（可选，缺省 512M / 384；384
# 留出堆外内存余量）。重负载/大实例前请同步调大两者；compose 与 Windows docker run 共用同一对值。
# DAEMON_MEMORY_LIMIT=512M
# DAEMON_NODE_HEAP_MB=384

# ==================== 进程模式实例进服端口（Windows daemon） ====================
# 仅 Windows 生效（ADR-016）：进程模式 PaperMC 实例（cwd 在 daemon 内部）的进服端口
# 须由 daemon 容器 -p 暴露。逗号分隔 host:container/proto。Java 版 25565/tcp、基岩版
# 19132/udp。macOS/Linux 的 daemon 走 compose 实例端口由 MCSManager 配置，不消费本变量。
# ⚠️ 只服务**进程模式**实例：**默认置空**。用进程模式实例（Windows）且需玩家经 daemon
#    端口进服时，取消下一行注释；用 **docker 型实例**（各自发布宿主端口）保持置空。
#    daemon 创建时若检测到 docker 型实例会**自动忽略**本变量（issue #6/#9）。
# DAEMON_PORTS=25565:25565/tcp,19132:19132/udp

# ==================== 统一状态页（Gatus） ====================
# 平台层常驻服务；页头聚合产品入口 + 实时健康卡片（数据仅内存）。
# DOMAIN_STATUS 为第 4 个本地入口（orzmcs.localhost）；STATUS_PORT 容器内仅 expose。
STATUS_PORT=8080

# ==================== QQ 开放平台 ====================
# EasyBot QQ 适配器凭据（本地验证无真实账号可先保留占位）
QQBOT_APP_ID=local_app_id
QQBOT_CLIENT_SECRET=local_client_secret

# ==================== 站点增量 override（issue #11） ====================
# 站点特有增量（飞书等适配器凭据、额外环境变量/挂载）统一写入 $DATA_ROOT/compose.site.yaml
# （init 生成，随数据保留、升级换包不丢）。也可额外追加任意路径的 compose 文件（空格/逗号分隔）：
# COMPOSE_FILE_EXTRA=

# ==================== 可选平台适配器（EasyBot） ====================
# 启用即加一行，勿注入空串：
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# ⚠️ 这些变量需经 compose 传给 easybot 容器；请写入 $DATA_ROOT/compose.site.yaml 的
#    easybot.environment（模板见该文件），不要直接改包内 compose.yaml（升级会丢，issue #11）。
# 微信：扫码登录无凭据，默认自动启用；禁用见 docs/easybot.md

# ==================== 应用数据库：MariaDB（默认启用） ====================
# 平台层常驻服务；数据落在 $DATA_ROOT/database/mariadb（随整机备份）；仅内网
# orzmc_default 可达 mariadb:3306，不发布宿主机端口、不设公网/边缘入口。
# PaperMC 插件（Dynmap/CoreProtect/LuckPerms/Towny/economy 等）需要时用
# jdbc:mysql://mariadb:3306/<MARIADB_DATABASE> 连接。以下四项为必需变量，
# 既有部署需手动补进已有 $DATA_ROOT/.env（deploy.sh validate 会强制校验）。
MARIADB_ROOT_PASSWORD=local_strong_password_change_me
MARIADB_DATABASE=papermc
MARIADB_USER=mc
MARIADB_PASSWORD=local_strong_password_change_me
