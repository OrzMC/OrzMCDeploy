# ===========================================================================
# OrzMC 运行配置模板 —— `./orzmc.sh init` 据此生成 $DATA_ROOT/.env
#
# .env 是唯一配置源（含密钥）：权限 600、永不入库。运行模型（局域网直连，ADR-027）、
# 每个变量的含义与内存调优见 docs/usage.md §4 / 附录 F；防火墙见 docs/security.md。
# 注意：同名键以**首次出现**为准，改值请改原行（不要文末追加同名行）。
# ===========================================================================

# ---- 基础 ----
TZ=Asia/Shanghai
# DATA_ROOT 由 init 写入你显式指定的路径（无默认值，ADR-033）；之后如需换路径，
# 用 ./orzmc.sh -d <新路径> 运行，别只改这一行（validate 会校验与生效值一致）。
DATA_ROOT=<DATA_ROOT>

# ---- 局域网入口：宿主发布端口（改完 up 即生效；init 不会覆盖已存在的 .env）----
# 下面两项是示例值：换成你自己的宿主局域网 IP 与网段（两者应属同一网段）
LAN_HOST_IP=192.168.0.10
LAN_MCS_WEB_PORT=18090
LAN_EASYBOT_PORT=18091

# ---- 暴露面（ADR-028）：绑定地址 + 防火墙来源 ----
# LAN_BIND_ADDR：0.0.0.0 所有网卡 / 127.0.0.1 仅本机（配合反代、VPN）/ 具体 IP 只绑该网卡
LAN_BIND_ADDR=0.0.0.0
# 防火墙放行来源：示例值，改成你的局域网网段（orzmc.sh firewall apply 使用）
LAN_CIDR=192.168.0.0/24
# 额外放行来源（逗号分隔，如 Tailscale 100.64.0.0/10、另一台机器 IP）；留空=不放行
ALLOW_EXTRA_CIDRS=

# ---- EasyBot 网关（可选服务：置 false 则不启动 easybot，核心 web/daemon 常驻）----
# 监听器仅 HTTP（可信内网）；对公网暴露须自备 TLS 反代或 VPN。
ENABLE_EASYBOT=true
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=lan_strong_password_change_me

# ---- 容器内端口（须与镜像默认一致；宿主端口见上方 LAN_*_PORT）----
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444

# ---- 内存上限（可选；缺省 daemon 512M/堆384、easybot 512M）----
# 调 daemon 时两个值要一起动（堆须小于容器上限）；宁可 OOM 暴露回归也别放大 easybot。
# DAEMON_MEMORY_LIMIT=512M
# DAEMON_NODE_HEAP_MB=384
# EASYBOT_MEMORY_LIMIT=512M

# ---- 仅 Windows：进程模式实例的进服端口（docker 型实例保持置空；issue #9）----
# DAEMON_PORTS=25565:25565/tcp,19132:19132/udp

# ---- 仅 firewall 消费：额外放行的实例端口（留空即用 25565,25566 / 19132 / 25575,25576）----
# MC_TCP_PORTS=
# MC_UDP_PORTS=
# RCON_PORTS=

# ---- 公网游戏端口（第二类有意 Any；留空 = 只允许 LAN_CIDR，见 docs/security.md §4）----
# 只有写进下面两行的端口才由 firewall apply 生成 OrzMC-MC-Public-*（RemoteAddress Any）；
# 需同时在路由器把相同端口转发到宿主机。RCON 永不写进这里。
# 清单 = Java(25565,25566) + 基岩 RakNet(UDP 19132,19133) + NetherNet 信令(TCP 19132,19133)
#      + NetherNet 媒体(UDP 19134,19135) + 语音(UDP 24454，需实例映射该端口)
# MC_PUBLIC_TCP=25565,25566,19132,19133
# MC_PUBLIC_UDP=19132,19133,19134,19135,24454

# ---- QQ 开放平台凭据（EasyBot QQ 适配器用；无真实账号可留占位）----
QQBOT_APP_ID=lan_app_id
QQBOT_CLIENT_SECRET=lan_client_secret

# ---- 站点增量（不要改包内 compose.yaml，升级会丢）----
# 站点特有的 env/挂载写 $DATA_ROOT/compose.site.yaml（init 已生成，升级换包不丢，
# 模板与示例见该文件）；也可用下面变量追加任意路径 compose 文件（空格/逗号分隔）：
# COMPOSE_FILE_EXTRA=
#
# 其它适配器（Telegram / Discord / 飞书）的变量清单见 docs/easybot.md「可选平台适配器」。
