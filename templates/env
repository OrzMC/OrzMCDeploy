# ===========================================================================
# OrzMC 运行配置模板 —— `./orzmc.sh init` 据此生成 $DATA_ROOT/.env
#
# .env 是唯一配置源（含密钥）：权限 600、永不入库。运行模型（局域网直连，ADR-027）、
# 每个变量的含义与内存调优见 docs/usage.md §4 / 附录 F；防火墙见 docs/security.md。
# 注意：同名键以**首次出现**为准，改值请改原行（不要文末追加同名行）。
# ===========================================================================

# ---- 基础 ----
TZ=Asia/Shanghai
# DATA_ROOT 由 init 写入你显式指定的路径（无默认值，ADR-033）；之后如需换路径，
# 用 ./orzmc.sh -d <新路径> 运行，别只改这一行（validate 会校验与生效值一致）。
DATA_ROOT=<DATA_ROOT>

# ---- 局域网入口：宿主发布端口（改完 up 即生效；init 不会覆盖已存在的 .env）----
# 下面两项是示例值：换成你自己的宿主局域网 IP 与网段（两者应属同一网段）
LAN_HOST_IP=192.168.0.10
LAN_MCS_WEB_PORT=18090
LAN_EASYBOT_PORT=18091

# ---- 暴露面（ADR-028）：绑定地址 + 防火墙来源 ----
# LAN_BIND_ADDR：0.0.0.0 所有网卡 / 127.0.0.1 仅本机（配合反代、VPN）/ 具体 IP 只绑该网卡
LAN_BIND_ADDR=0.0.0.0
# 防火墙放行来源：示例值，改成你的局域网网段（orzmc.sh firewall apply 使用）
LAN_CIDR=192.168.0.0/24
# 额外放行来源（逗号分隔，如 Tailscale 100.64.0.0/10、另一台机器 IP）；留空=不放行
ALLOW_EXTRA_CIDRS=

# ---- EasyBot 网关（可选服务：置 false 则不启动 easybot，核心 web/daemon 常驻）----
# 监听器仅 HTTP（可信内网）；对公网暴露须自备 TLS 反代或 VPN。
ENABLE_EASYBOT=true
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=lan_strong_password_change_me

# ---- 前端拓扑（可选；缺省全关，零影响；ADR-036）----
# 两个正交开关，四种组合（实现方式由 ENABLE_VELOCITY 派生，不需要第三个开关）：
#   V=false E=false  纯直连基线：Java/基岩直连实例（缺省）
#   V=false E=true   实例直挂 EaglerXPaper：同端口兼任 WSS；**不支持 Folia、不能改 UUID**
#   V=true  E=false  仅 Velocity：多服大厅，玩家端口由代理发布（基岩可托管在代理上）
#   V=true  E=true   Velocity + EaglerXServer：Web 客户端接入，支持 Folia、可改 UUID
# 升级提示：旧键 EAGLER_MODE=off|direct|proxy 仍可解析（两开关都未写时生效），validate 会提示迁移。
ENABLE_VELOCITY=false
ENABLE_EAGLER=false
# 可选：代理数据目录覆盖。ADR-040 起 Velocity 是面板实例，默认自动探测
# $DATA_ROOT/mcsmanager/daemon/data/InstanceData/<uuid>/（里面有 velocity.toml 或 velocity-*.jar）。
# VELOCITY_DIR=
# 玩家 Java 入口端口（ENABLE_VELOCITY=true 时由代理发布；false 时是实例端口，仅用于提示）
# EAGLER_JAVA_PORT=25565
# 仅 ENABLE_VELOCITY=true：实例内部端口（面板里把实例 docker 端口改成 <此端口>:25565，不再发布 25565）。
# 必须避开其他实例已占用的宿主端口（例：Folia 常用 25566 → Paper 改 25567）；多后端各占一个。
# EAGLER_BACKEND_PORT=25566
# 仅 ENABLE_VELOCITY=true：多后端列表（逗号分隔 <名字>=<地址>）。两种写法可混用：
#   <名字>=<端口>            实例发布到宿主的端口（=面板里的 docker 端口映射）
#   <名字>=<主机>:<端口>      任意可解析地址；实例与代理同处 orzmc_default 网络时，
#                            直接写实例容器名最省事（不用挪宿主端口、不抢 25565）
# 留空 = 单个后端 lobby = EAGLER_BACKEND_PORT（旧行为，老 .env 不用改）。
# 名字随意（大厅/生存/资源…）；validate 会拦格式/重复/走宿主端口时撞代理入口。
# VELOCITY_SERVERS=lobby=MCSM-aaaaaaaa:25565,survival=MCSM-bbbbbbbb:25565
# 玩家首次落地顺序（逗号分隔，名字须在上一行里）；留空 = 列表第一个。
# VELOCITY_TRY=lobby

# 仅 ENABLE_EAGLER=true：站点反代（Caddy）对外暴露的 WSS 端口（TLS 不在本仓库）。
# 可以**复用已有反代入口**（如 18443，按域名分流）→ 不需要新端口/路由器/防火墙改动。
# EAGLER_WS_PORT=18444
# 仅 ENABLE_EAGLER=true：只影响提示文案与反代片段（wss://<域名>:<端口>/）。留空则打印占位符。
# EAGLER_PUBLIC_HOST=
# 基岩（Geyser）装在谁身上由拓扑派生：有代理 → Geyser-Velocity（端口由代理发布）；
# 无代理 → 留给实例侧 Geyser-Spigot（端口保持原样）。EAGLER_GEYSER=false 一律不装。
# 传输方式（Geyser 2.12 起 raknet-only 已移除）：
#   both      信令 TCP + RakNet UDP + NetherNet UDP（媒体端口独立）——兼容老客户端
#   nethernet 只走 NetherNet；把 EAGLER_GEYSER_WEBRTC_PORT 设成 0 即让媒体复用主端口，
#             端口集合缩到「一个端口号（TCP 信令 + UDP 媒体）」
# EAGLER_GEYSER=true
# EAGLER_GEYSER_TRANSPORT=both
# EAGLER_GEYSER_PORT=19132
# EAGLER_GEYSER_WEBRTC_PORT=19134   # 设 0 = 复用 EAGLER_GEYSER_PORT（需 transport=nethernet）

# ---- Web 客户端托管（可选；ENABLE_WEBMC=true 时启动 webmc 容器）----
# 只提供入口/深链/外嵌，**镜像不含客户端本体**；把官方客户端放到
# ${DATA_ROOT}/webmc/versions/<版本>/client.html 后再启动/重启 webmc。
# 客户端 ARR/EULA：仅私有兜底，不公开分发、不商业化。
ENABLE_WEBMC=false
LAN_WEBMC_PORT=18092
# 镜像：默认 GHCR。若包仍为 private：先在宿主机 docker login ghcr.io（PAT read:packages），
# 或把 GitHub Packages 里 orzmc-webmc 的可见性改为 public。
WEBMC_IMAGE=ghcr.io/orzmc/orzmc-webmc:0.1.0
# 允许哪些站点 iframe 嵌入（CSP frame-ancestors；生产建议收窄到官网域名）
# WEBMC_FRAME_ANCESTORS=https://orzmc.jokerhub.cn
# API 绝对 URL/反代对外地址（只影响 /api/versions 的 playUrl/embedUrl）
# WEBMC_PUBLIC_BASE_URL=https://webclient.example.com
# 默认版本；留空 = 数据目录排序最后的版本
# WEBMC_DEFAULT_VERSION=26.3
# 私有入口令牌；非空则 /play、/embed、/client 需要 ?token=
# WEBMC_ACCESS_TOKEN=
# 客户端补丁需要一定堆；默认 512M，容器上限 768M
# WEBMC_JAVA_OPTS=-Xms256m -Xmx512m

# ---- 容器内端口（须与镜像默认一致；宿主端口见上方 LAN_*_PORT）----
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444

# ---- 内存上限（可选；缺省 daemon 512M/堆384、easybot 512M）----
# 调 daemon 时两个值要一起动（堆须小于容器上限）；宁可 OOM 暴露回归也别放大 easybot。
# DAEMON_MEMORY_LIMIT=512M
# DAEMON_NODE_HEAP_MB=384
# EASYBOT_MEMORY_LIMIT=512M

# ---- 仅 Windows：进程模式实例的进服端口（docker 型实例保持置空；issue #9）----
# DAEMON_PORTS=25565:25565/tcp,19132:19132/udp

# ---- 仅 firewall 消费：额外放行的实例端口（留空即用 25565,25566 / 19132 / 25575,25576）----
# MC_TCP_PORTS=
# MC_UDP_PORTS=
# RCON_PORTS=

# ---- 公网游戏端口（第二类有意 Any；留空 = 只允许 LAN_CIDR，见 docs/security.md §4）----
# 只有写进下面两行的端口才由 firewall apply 生成 OrzMC-MC-Public-*（RemoteAddress Any）；
# 需同时在路由器把相同端口转发到宿主机。RCON 永不写进这里。
# 清单 = Java(25565,25566) + 基岩 RakNet(UDP 19132,19133) + NetherNet 信令(TCP 19132,19133)
#      + NetherNet 媒体(UDP 19134,19135) + 语音(UDP 24454，需实例映射该端口)
# MC_PUBLIC_TCP=25565,25566,19132,19133
# MC_PUBLIC_UDP=19132,19133,19134,19135,24454

# ---- QQ 开放平台凭据（EasyBot QQ 适配器用；无真实账号可留占位）----
QQBOT_APP_ID=lan_app_id
QQBOT_CLIENT_SECRET=lan_client_secret

# ---- 站点增量（不要改包内 compose.yaml，升级会丢）----
# 站点特有的 env/挂载写 $DATA_ROOT/compose.site.yaml（init 已生成，升级换包不丢，
# 模板与示例见该文件）；也可用下面变量追加任意路径 compose 文件（空格/逗号分隔）：
# COMPOSE_FILE_EXTRA=
#
# 其它适配器（Telegram / Discord / 飞书）的变量清单见 docs/easybot.md「可选平台适配器」。
