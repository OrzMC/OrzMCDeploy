# ===========================================================================
# 局域网直连模板（lan.sh init 使用，lan profile：无 TLS 终止直连模式）
#
# DATA_ROOT 占位由脚本替换（lan.sh 默认仓库下 .local-data-lan）；
# 生成目标为 $DATA_ROOT/.env，不入 Git。
#
# lan 模式与 local/prod 的最大区别：**无边缘层、无域名、无 TLS**。
#   无 Caddy / cloudflared；4 个源站（mcs 面板 / easybot / status / daemon）
#   直接发布宿主端口，局域网设备用 http://<宿主LAN IP>:<端口> 访问。
#   属"不做 TLS 终止"的可选模式：局域网明文 HTTP，仅限可信内网。
# ===========================================================================

# ==================== 基础 ====================
TZ=Asia/Shanghai
DATA_ROOT=<DATA_ROOT>

# ==================== lan 直连：宿主发布端口 ====================
# LAN_HOST_IP 为宿主局域网 IP：局域网设备访问入口，同时被 Gatus 按钮链接与
# init 打印访问地址使用。DHCP 变更需同步更新并删除已落盘 status/config.yaml
# 后重新 init（建议宿主用静态 IP / DHCP 保留地址）。
# 宿主发布端口默认 18090/18091/18092/24444，避开 local Caddy 的 18080/18443
# 与实例端口 25565/25566；按需用 LAN_*_PORT 覆盖。
LAN_HOST_IP=192.168.1.100
LAN_MCS_WEB_PORT=18090
LAN_EASYBOT_PORT=18091
LAN_STATUS_PORT=18092
LAN_MCS_DAEMON_PORT=24444

# ==================== EasyBot 网关 ====================
# 监听器仅 HTTP，lan 下无边缘层承担 TLS —— 局域网明文（可信内网假设）；
# 微信适配器默认自动启用，禁用见 docs/easybot.md（gateway.local.yaml）
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=lan_strong_password_change_me

# ==================== MCSManager 平台 ====================
# 容器内端口（宿主发布端口见上方 LAN_*_PORT）
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444
# daemon 节点连接地址保持内网直连 ws://mcsmanager-daemon:24444（ADR-011，
# 与 prod/local 相同，零运行时改动）；浏览器「网页直连」终端在 lan 下同样
# 不可用（浏览器解析不了 mcsmanager-daemon），非故障。

# ==================== 统一状态页（Gatus） ====================
# 平台层常驻服务；页头聚合产品入口 + 实时健康卡片（数据仅内存）。
# lan 下入口为 http://<LAN_HOST_IP>:<LAN_STATUS_PORT>；STATUS_PORT 容器内仅 expose。
STATUS_PORT=8080

# ==================== QQ 开放平台 ====================
# EasyBot QQ 适配器凭据（本地验证无真实账号可先保留占位）
QQBOT_APP_ID=lan_app_id
QQBOT_CLIENT_SECRET=lan_client_secret

# ==================== 可选平台适配器（EasyBot） ====================
# 启用即加一行，勿注入空串：
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# 微信：扫码登录无凭据，默认自动启用；禁用见 docs/easybot.md

# ==================== 应用数据库：MariaDB（默认启用） ====================
# 平台层常驻服务；数据落在 $DATA_ROOT/database/mariadb（随整机备份）；仅内网
# orzmc_default 可达 mariadb:3306，不发布宿主机端口、不设公网/边缘入口。
# PaperMC 插件（Dynmap/CoreProtect/LuckPerms/Towny/economy 等）需要时用
# jdbc:mysql://mariadb:3306/<MARIADB_DATABASE> 连接。以下四项为必需变量，
# 既有部署需手动补进已有 $DATA_ROOT/.env（deploy.sh validate 会强制校验）。
MARIADB_ROOT_PASSWORD=lan_strong_password_change_me
MARIADB_DATABASE=papermc
MARIADB_USER=mc
MARIADB_PASSWORD=lan_strong_password_change_me
