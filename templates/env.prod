# ===========================================================================
# 生产环境模板（deploy.sh init 默认，prod profile：Cloudflare Tunnel）
#
# init 会把它生成到 $DATA_ROOT/.env（DATA_ROOT 行按生效值改写），
# 该文件随数据目录一起迁移与备份，属运行数据的一部分，不入 Git。
#
# 生产网络拓扑：
#   - 公网暴露 4 个入口：mcs.<domain>（MCSManager 面板）、easybot.<domain>
#     （EasyBot 管理后台）、mcs-node.<domain>（daemon 直连）、orzmcs.<domain>
#     （统一状态页，Gatus），经 Cloudflare Tunnel（cloudflared 出站隧道）转发；
#     宿主机无需开放任何端口、无需 ACME。
#   - EasyBot 插件 API 仅内网：插件挂 orzmc_default 网络直连
#     http://easybot:8080（REST + WS），无需公网域名。
# ===========================================================================

# ==================== 基础 ====================
TZ=Asia/Shanghai
DATA_ROOT=/srv/orzmc

# ==================== 边缘层：Cloudflare Tunnel ====================
# 由 `cloudflared tunnel create` 取得（一次性初始化，见 EXECUTION_PATH.md）
CLOUDFLARE_TUNNEL_ID=<tunnel-uuid>

# cloudflared 容器解析 Cloudflare 边缘使用的公网 DNS（仅 prod 生效；绕开宿主 fake-ip
# 代理对 DNS 的劫持，否则边缘解析到假 IP、隧道 530）。可选变量：缺省/留空时 compose
# 回退默认 223.5.5.5（阿里，国内可达）+ 1.1.1.1（Cloudflare，兜底）；按网络环境自选
# （内网解析器等）。无 fake-ip 代理的干净宿主可删掉这两行（默认 Docker DNS 即可）。
DNS_PRIMARY=223.5.5.5
DNS_SECONDARY=1.1.1.1

# ==================== 公网入口域名 ====================
# 命名约定：子域名 = 产品代号；mcs / easybot 为管理后台，mcs-node 为 daemon 直连，
# orzmcs 为统一状态页（Gatus，第 4 个入口）
DOMAIN_MCS_WEB=mcs.example.com
DOMAIN_EASY_ADMIN=easybot.example.com
DOMAIN_MCS_NODE=mcs-node.example.com
DOMAIN_STATUS=orzmcs.example.com

# ==================== EasyBot 网关 ====================
# 监听器仅 HTTP，TLS 由 Cloudflare 边缘承担；微信适配器默认自动启用，
# 禁用见 docs/easybot.md（gateway.local.yaml）
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=change_me_strong_password

# ==================== MCSManager 平台 ====================
# 容器内端口，仅 expose 不发布宿主机
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444

# ==================== 统一状态页（Gatus） ====================
# 平台层常驻服务；页头聚合产品入口 + 实时健康卡片（数据仅内存）。
# DOMAIN_STATUS 为第 4 个入口（orzmcs.<domain>）；STATUS_PORT 容器内仅 expose。
STATUS_PORT=8080

# ==================== QQ 开放平台 ====================
# EasyBot QQ 适配器凭据（官方 bot，非个人账号扫码登录）
QQBOT_APP_ID=your_app_id_here
QQBOT_CLIENT_SECRET=your_client_secret_here

# ==================== 可选平台适配器（EasyBot） ====================
# 启用即加一行，勿注入空串：
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# 微信：扫码登录无凭据，默认自动启用；禁用见 docs/easybot.md

# ==================== 应用数据库：MariaDB（默认启用） ====================
# 平台层常驻服务；数据落在 $DATA_ROOT/database/mariadb（随整机备份）；仅内网
# orzmc_default 可达 mariadb:3306，不发布宿主机端口、不设公网/边缘入口。
# PaperMC 插件（Dynmap/CoreProtect/LuckPerms/Towny/economy 等）需要时用
# jdbc:mysql://mariadb:3306/<MARIADB_DATABASE> 连接。以下四项为必需变量，
# 既有部署需手动补进已有 $DATA_ROOT/.env（deploy.sh validate 会强制校验）。
MARIADB_ROOT_PASSWORD=change_me_strong_password
MARIADB_DATABASE=papermc
MARIADB_USER=mc
MARIADB_PASSWORD=change_me_strong_password
