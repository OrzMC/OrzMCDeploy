# ===========================================================================
# 生产环境模板（deploy.sh init 默认，prod profile：Cloudflare Tunnel）
#
# init 会把它生成到 $DATA_ROOT/.env（DATA_ROOT 行按生效值改写），
# 该文件随数据目录一起迁移与备份，属运行数据的一部分，不入 Git。
#
# 生产网络拓扑：
#   - 公网只暴露 2 个入口：mcs.<domain>（MCSManager 面板）、easybot.<domain>
#     （EasyBot 管理后台），经 Cloudflare Tunnel（cloudflared 出站隧道）转发；
#     宿主机无需开放任何端口、无需 ACME。
#   - EasyBot 插件 API 仅内网：插件挂 orzmc_default 网络直连
#     http://easybot:8080（REST + WS），无需公网域名。
#   - daemon 不暴露：面板→daemon 走内部地址 http://mcsmanager-daemon:24444。
# ===========================================================================

# 基础环境
TZ=Asia/Shanghai
DATA_ROOT=/srv/orzmc

# Cloudflare Tunnel（prod 唯一公网入口；由 `cloudflared tunnel create` 取得，见
# EXECUTION_PATH.md Stage 2 的一次性初始化）
CLOUDFLARE_TUNNEL_ID=<tunnel-uuid>

# 公网域名（命名约定：子域名 = 产品代号，无后缀即该产品管理控制台）
#   mcs.<domain>    → MCSManager 面板
#   easybot.<domain> → EasyBot 管理后台
#   mcs-node.<domain> → MCSManager daemon/节点（浏览器直连入口，密钥鉴权）
DOMAIN_MCS_WEB=mcs.example.com
DOMAIN_EASY_ADMIN=easybot.example.com
DOMAIN_MCS_NODE=mcs-node.example.com

# EasyBot 统一 IM 网关（取代 NapCat）；监听器仅 HTTP，TLS 由 Cloudflare 边缘承担
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=change_me_strong_password

# MCSManager 平台端口（容器内，仅 expose 不发布宿主机）
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444

# QQ 开放平台凭据（EasyBot QQ 适配器消费；注意非 NapCat 个人账号扫码登录）
QQBOT_APP_ID=your_app_id_here
QQBOT_CLIENT_SECRET=your_client_secret_here

# 以下为 monorepo 联调脚本参考（scripts/ubuntu/qqbot/test-qqbot.sh），
# compose 不消费，仅随 .env 迁移保存
QQBOT_GUILD_ID=4678868088901888449
QQBOT_CHANNEL_ID=716172984
QQBOT_DM_GUILD_ID=4678868088901888449
QQBOT_PRIVATE_USER_ID=1F57730D6ADC5F5CD417D5614A52F2CF
QQBOT_MEMBER_LIMIT=20
QQBOT_TEST_MESSAGE=hello from qq bot

# 可选平台适配器：启用时在 compose.yaml easybot service 增加对应环境变量
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
