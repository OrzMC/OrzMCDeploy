# ===========================================================================
# 生产环境模板（deploy.sh init 默认）
#
# init 会把它生成到 $DATA_ROOT/.env（DATA_ROOT 行按生效值改写），
# 该文件随数据目录一起迁移与备份，属运行数据的一部分，不入 Git。
# ===========================================================================

# 基础环境
TZ=Asia/Shanghai
DATA_ROOT=/srv/orzmc

# 对外入口与域名
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
DOMAIN_MCS_WEB=mcs.example.com
DOMAIN_MCS_NODE=node.mcs.example.com

# EasyBot 统一 IM 网关（取代 NapCat）
# DOMAIN_EASY_ADMIN: 管理后台（创建 API Key 与会话）
# DOMAIN_EASY_API:   插件连接的 REST + WebSocket 入口（同一域名）
DOMAIN_EASY_ADMIN=easyadmin.example.com
DOMAIN_EASY_API=easyapi.example.com
EASYBOT_PORT=8080
EASYBOT_ADMIN_PASSWORD=change_me_strong_password

# MCSManager 平台端口
MCS_WEB_PORT=23333
MCS_DAEMON_PORT=24444

# QQ 开放平台凭据（EasyBot QQ 适配器消费；注意非 NapCat 个人账号扫码登录）
QQBOT_APP_ID=your_app_id_here
QQBOT_CLIENT_SECRET=your_client_secret_here

# 以下为 monorepo 联调脚本参考（scripts/ubuntu/qqbot/test-qqbot.sh），
# compose 不消费，仅随 .env 迁移保存
QQBOT_GUILD_ID=4678868088901888449
QQBOT_CHANNEL_ID=716172984
QQBOT_DM_GUILD_ID=4678868088901888449
QQBOT_PRIVATE_USER_ID=1F57730D6ADC5F5CD417D5614A52F2CF
QQBOT_MEMBER_LIMIT=20
QQBOT_TEST_MESSAGE=hello from qq bot

# 可选平台适配器：启用时在 compose.yaml easybot service 增加对应环境变量
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
