# ===========================================================================
# Eaglercraft 接入的版本锁（EAGLER_MODE≠off 时由 lib/eagler.sh 校验并下载）
#
# 升级流程：改版本号 + URL + sha256 → 跑一次 up（会重新下载并校验）→ git commit。
# sha256 一律来自官方下载文件实测（sha256sum <文件>），不要凭 README 填写。
# PaperMC 的 fill API 对象 URL 自带 sha256，可直接对照。
# ===========================================================================

VELOCITY_VERSION=4.3.1
VELOCITY_BUILD=45
VELOCITY_URL=https://fill-data.papermc.io/v1/objects/0844bcabdcdb4f5b875906fd4c3365bc1bb76918e42bc595ed88ad195258dd75/velocity-4.3.1-45.jar
VELOCITY_SHA256=0844bcabdcdb4f5b875906fd4c3365bc1bb76918e42bc595ed88ad195258dd75

EAGLERXSERVER_VERSION=1.1.1
EAGLERXSERVER_URL=https://github.com/lax1dude/eaglerxserver/releases/download/v1.1.1/EaglerXServer.jar
EAGLERXSERVER_SHA256=468cb07eb7ca466b21b439be75156d3d01579327f4c6dae5b67d471137a64208

EAGLERXPAPER_VERSION=1.1.1-S2
EAGLERXPAPER_URL=https://github.com/PlanetDogeCodes/EaglerXPaper/releases/download/v1.1.1-S2/EaglerXPaper-v1.1.1-Stable2.jar
EAGLERXPAPER_SHA256=56079cac8e7b393a0394227a77e73dd55fb6f8a952cad1529ad7faf7054e6f57

# 客户端（只用于文档/status 提示，不会被下载）
EAGLER_CLIENT_VERSION=26.3
EAGLER_CLIENT_URL=https://cdn.eaglercraft.net/objects/dl/26.3/eaglercraft-26.3-fe8f1237-815f7813.zip
